{
  "name": "task-tracker",
  "version": "1.0.0",
  "description": "A minimal task tracker application built with React 16 and json-server",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "server": "json-server --watch db.json --port 3000",
    "dev": "concurrently \"npm run server\" \"npm start\""
  },
  "dependencies": {
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.18.0",
    "babel-loader": "^9.1.0",
    "concurrently": "^7.6.0",
    "css-loader": "^6.7.0",
    "html-webpack-plugin": "^5.5.0",
    "json-server": "^0.17.3",
    "style-loader": "^3.3.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.11.0"
  }
}
